:root {
  --bg: #0f1216; --panel: #171c23; --panel2: #1e252e; --line: #2a3340;
  --fg: #d8dee7; --dim: #7d8b9d; --acc: #4da3ff; --ok: #35c46f; --bad: #ff5d5d; --warn: #ffb84d;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg);
  font: 14px/1.5 "Segoe UI", "Microsoft YaHei", sans-serif; }
button { font: inherit; }
input, select, textarea { background: var(--panel2); color: var(--fg);
  border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px; font: inherit; }
textarea { width: 100%; resize: vertical; font-family: Consolas, monospace; }

.topbar { display: flex; align-items: center; gap: 18px; padding: 10px 16px;
  background: var(--panel); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; }
.brand { font-size: 18px; font-weight: 700; color: var(--acc); }
.topstats { display: flex; align-items: center; gap: 6px; color: var(--dim); }
.stat-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--bad); display: inline-block; }
.stat-dot.on { background: var(--ok); }
.stat-num { color: var(--fg); font-weight: 600; }
.topactions { margin-left: auto; display: flex; gap: 8px; }
.chk.consent { font-size: 12px; color: var(--dim); cursor: pointer; }
.hidden { display: none !important; }

.layout { display: flex; min-height: calc(100vh - 52px); }
.sidebar { width: 260px; background: var(--panel); border-right: 1px solid var(--line);
  padding: 12px; flex-shrink: 0; }
.side-title { color: var(--dim); font-size: 12px; margin: 10px 0 6px; text-transform: uppercase; letter-spacing: .05em; }
.device-list, .group-list { list-style: none; margin: 0 0 8px; padding: 0; max-height: 300px; overflow: auto; }
.device-list li, .group-list li { display: flex; align-items: center; gap: 6px;
  padding: 4px 6px; border-radius: 6px; cursor: default; }
.device-list li:hover { background: var(--panel2); }
.dstate { width: 8px; height: 8px; border-radius: 50%; background: var(--bad); flex-shrink: 0; }
.dstate.device { background: var(--ok); }
.dstate.offline, .dstate.unauthorized, .dstate.absent { background: var(--warn); }
.dserial { font-family: Consolas, monospace; font-size: 12px; }
.dmodel { color: var(--dim); font-size: 11px; margin-left: auto; }
.group-list li { justify-content: space-between; }
.group-list .gname { color: var(--fg); }
.group-list .gcount { color: var(--dim); font-size: 12px; }
.group-add, .group-ops { display: flex; gap: 6px; margin-bottom: 8px; }
.group-ops select { flex: 1; }

.content { flex: 1; padding: 14px 18px; min-width: 0; }
.tabs { display: flex; gap: 4px; margin-bottom: 14px; flex-wrap: wrap; }
.tab { background: var(--panel); border: 1px solid var(--line); color: var(--dim);
  padding: 8px 14px; border-radius: 8px 8px 0 0; cursor: pointer; border-bottom: none; }
.tab.active { color: var(--fg); background: var(--panel2); }
.tabpane { display: none; }
.tabpane.active { display: block; }

.pane-card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
  padding: 14px 16px; margin-bottom: 14px; }
.pane-card h3 { margin: 0 0 10px; font-size: 15px; }
.pane-card.narrow { width: 300px; flex-shrink: 0; }
.pane-card.grow { flex: 1; min-width: 0; }
.split { display: flex; gap: 14px; align-items: flex-start; }

.form-row { display: flex; align-items: center; gap: 8px; margin: 8px 0; flex-wrap: wrap; }
.form-row label { color: var(--dim); min-width: fit-content; }
.form-row .num { width: 70px; }
.spacer { flex: 1; }
.hint { color: var(--dim); font-size: 12px; }
.chk { display: inline-flex; align-items: center; gap: 4px; color: var(--fg); }

.btn { background: var(--panel2); color: var(--fg); border: 1px solid var(--line);
  border-radius: 6px; padding: 6px 12px; cursor: pointer; }
.btn:hover { border-color: var(--acc); }
.btn.primary { background: var(--acc); border-color: var(--acc); color: #08111d; font-weight: 600; }
.btn.danger { background: transparent; border-color: var(--bad); color: var(--bad); }
.btn.small { padding: 3px 8px; font-size: 12px; }
.btn:disabled { opacity: .5; cursor: not-allowed; }
.filelabel { display: inline-flex; align-items: center; }

.device-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 12px; }
.device-card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
  overflow: hidden; }
.device-card .shot { width: 100%; aspect-ratio: 9/19; object-fit: contain; background: #000;
  cursor: pointer; display: block; }
.device-card .meta { padding: 6px 10px; display: flex; align-items: center; gap: 6px; }
.device-card .name { font-size: 12px; font-family: Consolas, monospace; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; }
.device-card.offline { opacity: .45; }

.data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.data-table th, .data-table td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); }
.data-table th { color: var(--dim); font-weight: 500; }

.steps-table { width: 100%; border-collapse: collapse; font-size: 13px; margin: 6px 0; }
.steps-table td { padding: 4px 6px; border-bottom: 1px solid var(--line); }
.step-badge { background: var(--panel2); border: 1px solid var(--line); color: var(--acc);
  border-radius: 4px; padding: 1px 6px; font-family: Consolas, monospace; font-size: 11px; }
.plain-list { list-style: none; padding: 0; margin: 0 0 8px; }
.plain-list li { display: flex; align-items: center; gap: 6px; padding: 4px 6px; border-radius: 6px; }
.plain-list li:hover { background: var(--panel2); }
.plain-list li.active { background: var(--panel2); outline: 1px solid var(--acc); }

.result-box { background: var(--panel2); border: 1px solid var(--line); border-radius: 8px;
  padding: 8px 10px; font-size: 12px; max-height: 320px; overflow: auto; font-family: Consolas, monospace; }
.console-out { background: #0a0d10; border: 1px solid var(--line); border-radius: 8px;
  padding: 10px; height: 420px; overflow: auto; font-family: Consolas, monospace; font-size: 12px;
  white-space: pre-wrap; margin: 8px 0 0; }
.log-info { color: var(--fg); } .log-warn { color: var(--warn); } .log-error { color: var(--bad); }

.capture-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
.capture-grid img { width: 100%; border-radius: 8px; border: 1px solid var(--line); }
.capture-grid .cap { font-size: 11px; color: var(--dim); word-break: break-all; }

.modal { position: fixed; inset: 0; background: rgba(0,0,0,.7); display: flex;
  align-items: center; justify-content: center; z-index: 100; }
.modal.hidden { display: none; }
.mirror-wrap { background: var(--panel); border: 1px solid var(--line); border-radius: 12px;
  padding: 10px; max-width: 94vw;
  /* 支持拖拽移动 + 调整大小 */
  position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
  min-width: 360px; min-height: 320px;
  resize: both; overflow: auto;
  cursor: default; user-select: none;
  box-shadow: 0 8px 40px rgba(0,0,0,.6);
}
/* 拖拽移动：仅在标题栏生效 */
.mirror-bar { cursor: move; padding: 6px 8px; border-radius: 8px 8px 0 0;
  background: var(--panel2); margin: -10px -10px 8px -10px; }
.mirror-bar:active { cursor: grabbing; }
/* 调整大小的视觉提示（四角 + 四边） */
.mirror-wrap::after {
  content: ''; position: absolute; inset: 0; pointer-events: none;
  border: 1px solid transparent; border-radius: 12px;
  transition: border-color .15s;
}
.mirror-wrap:hover::after { border-color: var(--line); }
/* 右下角resize handle可见化 */
.mirror-wrap > .mirror-stage { position: relative; }
.mirror-wrap > .mirror-stage::after {
  content: ''; position: absolute; right: 0; bottom: 0; width: 14px; height: 14px;
  cursor: se-resize;
  background: transparent;
}
.mirror-wrap > .mirror-stage::after:hover { background: rgba(77,163,255,.15); }
.mirror-bar, .mirror-subbar { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
.mirror-subbar { margin-bottom: 6px; }
.mirror-bar .chk, .mirror-subbar .chk { color: var(--dim); }
#mm-title { font-weight: 600; }
.mirror-stage { display: flex; justify-content: center; background: #000; border-radius: 8px;
  max-height: 74vh; overflow: hidden; position: relative;
  /* 画布随内容收缩：消除两侧黑色“可点但坐标无效”的边条 */
  width: fit-content; }
mirror-move { position: fixed; top: 50%; left: 50%; Transform: translate(-50%, -50%); Cursor: default; User-select: none; Box-shadow: 0 8px 40px rgba(0,0,0,.6); Min-width: 360px; Min-height: 320px; Resize: both; Overflow: auto; }
.mirror-move .mirror-bar { Cursor: grab; }
.mirror-move .mirror-bar:active { Cursor: grabbing; }
.mirror-move > .mirror-stage::after { Cursor: se-resize; }
mirror-resize-handler { position: absolute; right: 0; bottom: 0; width: 14px; height: 14px;
  cursor: se-resize; display: block; z-index: 5;
  border: 1px solid var(--line); border-radius: 2px; margin: -1px -1px 0 0;
  background: var(--panel);
  transition: background .15s;
}
mirror-resize-handler:hover { background: var(--panel2); }
mirror-resize-handler::before, mirror-resize-handler::after {
  content: ''; position: absolute; background: var(--line);
  border-radius: 1px;
}
mirror-resize-handler::before { left: 4px; top: 0; bottom: 0; width: 1px; }
mirror-resize-handler::after { top: 4px; left: 0; right: 0; height: 1px; }
.mirror-wrap > .mirror-stage { padding-bottom: 14px; }
.ripple { position: absolute; width: 12px; height: 12px; margin: -6px 0 0 -6px;
  border: 2px solid #4da3ff; border-radius: 50%; pointer-events: none; z-index: 5;
  animation: rip .55s ease-out forwards; }
@keyframes rip { from { transform: scale(.4); opacity: .95; } to { transform: scale(5); opacity: 0; } }
#mm-inject-status.ok { color: var(--ok); }
#mm-inject-status.bad { color: var(--bad); }
#mm-inject-status.warn { color: var(--warn); }
#mm-canvas { max-height: 74vh; max-width: 92vw; background: #000; cursor: crosshair; display: block; }

.toasts { position: fixed; right: 16px; bottom: 16px; display: flex; flex-direction: column;
  gap: 8px; z-index: 200; }
.toast { background: var(--panel2); border: 1px solid var(--line); border-left: 3px solid var(--acc);
  border-radius: 8px; padding: 8px 12px; min-width: 220px; max-width: 420px; font-size: 13px;
  box-shadow: 0 4px 16px rgba(0,0,0,.5); }
.toast.error { border-left-color: var(--bad); }
.toast.ok { border-left-color: var(--ok); }
.toast.warn { border-left-color: var(--warn); }
