{
  "name": "知乎文章发布",
  "platform": "知乎",
  "package": "com.zhihu.android",
  "description": "知乎文章/回答发布流程，含标题/正文/话题填写，风控检测与发布验证",
  "variables": ["title", "content", "topics"],
  "timeout_seconds": 180,
  "steps": [
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证", "操作频繁", "账号异常"], "on_risk": "abort"},
    {"type": "launch", "package": "com.zhihu.android"},
    {"type": "wait", "ms": 3000},
    {"type": "tap_el", "kind": "desc", "value": "写文章", "contains": true},
    {"type": "wait", "ms": 2000},
    {"type": "tap_el", "kind": "id", "value": "com.zhihu.android:id/title_input", "contains": false, "on_fail": "continue"},
    {"type": "wait", "ms": 500},
    {"type": "text", "text": "{{title}}"},
    {"type": "wait", "ms": 500},
    {"type": "tap_el", "kind": "id", "value": "com.zhihu.android:id/content_editor", "contains": false, "on_fail": "continue"},
    {"type": "wait", "ms": 500},
    {"type": "text", "text": "{{content}}"},
    {"type": "wait", "ms": 1000},
    {"type": "tap_el", "kind": "desc", "value": "添加话题", "contains": true, "on_fail": "continue"},
    {"type": "wait", "ms": 1000},
    {"type": "text", "text": "{{topics}}"},
    {"type": "wait", "ms": 500},
    {"type": "back"},
    {"type": "wait", "ms": 500},
    {"type": "tap_el", "kind": "desc", "value": "设置封面", "contains": true, "on_fail": "continue"},
    {"type": "wait", "ms": 1000},
    {"type": "back"},
    {"type": "wait", "ms": 500},
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证", "账号异常"], "on_risk": "abort"},
    {"type": "tap_el", "kind": "desc", "value": "发布", "contains": true},
    {"type": "wait", "ms": 3000},
    {"type": "tap_el", "kind": "desc", "value": "确认发布", "contains": true, "on_fail": "continue"},
    {"type": "wait", "ms": 5000},
    {"type": "verify_publish", "ocr_text": "已发布", "wait_ms": 6000, "strict_ocr": false},
    {"type": "detect_risk", "ocr_keywords": ["审核", "违规", "限制"], "on_risk": "screenshot"}
  ]
}
