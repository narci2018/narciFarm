{
  "name": "B站视频发布",
  "platform": "B站",
  "package": "tv.danmaku.bili",
  "description": "B站(bilibili)视频投稿发布流程，含标题/简介/标签填写，风控检测与发布验证",
  "variables": ["title", "description", "tags"],
  "timeout_seconds": 180,
  "steps": [
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证", "操作过于频繁"], "on_risk": "abort"},
    {"type": "launch", "package": "tv.danmaku.bili"},
    {"type": "wait", "ms": 4000},
    {"type": "tap_el", "kind": "desc", "value": "投稿", "contains": true},
    {"type": "wait", "ms": 2000},
    {"type": "tap_el", "kind": "desc", "value": "视频", "contains": true},
    {"type": "wait", "ms": 1500},
    {"type": "tap_el", "kind": "desc", "value": "下一步", "contains": true},
    {"type": "wait", "ms": 2000},
    {"type": "tap_el", "kind": "id", "value": "tv.danmaku.bili:id/video_title", "contains": false},
    {"type": "wait", "ms": 500},
    {"type": "text", "text": "{{title}}"},
    {"type": "wait", "ms": 500},
    {"type": "tap_el", "kind": "id", "value": "tv.danmaku.bili:id/video_desc", "contains": false},
    {"type": "wait", "ms": 500},
    {"type": "text", "text": "{{description}}"},
    {"type": "wait", "ms": 500},
    {"type": "tap_el", "kind": "desc", "value": "添加标签", "contains": true, "on_fail": "continue"},
    {"type": "wait", "ms": 1000},
    {"type": "text", "text": "{{tags}}"},
    {"type": "wait", "ms": 500},
    {"type": "back"},
    {"type": "wait", "ms": 500},
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证"], "on_risk": "abort"},
    {"type": "tap_el", "kind": "desc", "value": "发布", "contains": true},
    {"type": "wait", "ms": 5000},
    {"type": "verify_publish", "ocr_text": "投稿成功", "wait_ms": 8000, "strict_ocr": false},
    {"type": "detect_risk", "ocr_keywords": ["审核", "违规", "限制"], "on_risk": "screenshot"}
  ]
}
