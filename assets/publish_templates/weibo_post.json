{
  "name": "微博图文发布",
  "platform": "微博",
  "package": "com.sina.weibo",
  "description": "微博图文/文字发布流程，含风控检测与发布验证",
  "variables": ["title", "content", "hashtags"],
  "timeout_seconds": 120,
  "steps": [
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证", "操作频繁", "请稍后再试"], "on_risk": "abort"},
    {"type": "launch", "package": "com.sina.weibo"},
    {"type": "wait", "ms": 3000},
    {"type": "tap_el", "kind": "desc", "value": "写微博", "contains": true},
    {"type": "wait", "ms": 1500},
    {"type": "tap_el", "kind": "id", "value": "com.sina.weibo:id/edit_text", "contains": false},
    {"type": "wait", "ms": 500},
    {"type": "text", "text": "{{content}}"},
    {"type": "wait", "ms": 500},
    {"type": "tap_el", "kind": "desc", "value": "添加话题", "contains": true, "on_fail": "continue"},
    {"type": "wait", "ms": 1000},
    {"type": "text", "text": "{{hashtags}}"},
    {"type": "wait", "ms": 500},
    {"type": "back"},
    {"type": "wait", "ms": 500},
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证"], "on_risk": "abort"},
    {"type": "tap_el", "kind": "desc", "value": "发送", "contains": true},
    {"type": "wait", "ms": 3000},
    {"type": "verify_publish", "ocr_text": "{{title}}", "wait_ms": 5000, "strict_ocr": false},
    {"type": "detect_risk", "ocr_keywords": ["发送失败", "网络异常", "审核中"], "on_risk": "screenshot"}
  ]
}
