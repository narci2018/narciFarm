{
  "name": "视频号视频发布",
  "platform": "视频号",
  "package": "com.tencent.mm",
  "description": "微信视频号发布流程（从微信进入），含风控检测与发布验证",
  "variables": ["title", "description", "topics"],
  "timeout_seconds": 180,
  "steps": [
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证", "操作频繁", "环境异常"], "on_risk": "abort"},
    {"type": "launch", "package": "com.tencent.mm"},
    {"type": "wait", "ms": 3000},
    {"type": "tap_el", "kind": "desc", "value": "发现", "contains": true},
    {"type": "wait", "ms": 1500},
    {"type": "tap_el", "kind": "text", "value": "视频号", "contains": false},
    {"type": "wait", "ms": 2000},
    {"type": "tap_el", "kind": "desc", "value": "发表", "contains": true},
    {"type": "wait", "ms": 1500},
    {"type": "tap_el", "kind": "desc", "value": "发表视频", "contains": true},
    {"type": "wait", "ms": 2000},
    {"type": "tap_el", "kind": "desc", "value": "选择视频", "contains": true, "on_fail": "continue"},
    {"type": "wait", "ms": 1500},
    {"type": "tap_el", "kind": "desc", "value": "下一步", "contains": true},
    {"type": "wait", "ms": 1500},
    {"type": "tap_el", "kind": "id", "value": "com.tencent.mm:id/cd7", "contains": false, "on_fail": "continue"},
    {"type": "wait", "ms": 500},
    {"type": "text", "text": "{{title}}"},
    {"type": "wait", "ms": 500},
    {"type": "tap_el", "kind": "desc", "value": "添加话题", "contains": true, "on_fail": "continue"},
    {"type": "wait", "ms": 1000},
    {"type": "text", "text": "{{topics}}"},
    {"type": "wait", "ms": 500},
    {"type": "back"},
    {"type": "wait", "ms": 500},
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证", "环境异常"], "on_risk": "abort"},
    {"type": "tap_el", "kind": "desc", "value": "发表", "contains": true},
    {"type": "wait", "ms": 5000},
    {"type": "verify_publish", "ocr_text": "已发表", "wait_ms": 8000, "strict_ocr": false},
    {"type": "detect_risk", "ocr_keywords": ["发送失败", "网络异常"], "on_risk": "screenshot"}
  ]
}
