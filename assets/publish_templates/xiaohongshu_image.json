{
  "name": "小红书图文发布",
  "platform": "小红书",
  "description": "通过小红书App发布图文笔记（需提前登录）",
  "package": "com.xingin.xhs",
  "steps": [
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证", "操作频繁"], "on_risk": "abort"},
    {"type": "launch", "package": "com.xingin.xhs"},
    {"type": "wait", "ms": 3000},
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证"], "on_risk": "abort"},
    {"type": "tap_el", "kind": "desc", "value": "发布笔记", "timeout_ms": 5000},
    {"type": "wait", "ms": 2000},
    {"type": "tap_el", "kind": "text", "value": "图文", "timeout_ms": 5000},
    {"type": "wait", "ms": 2000},
    {"type": "tap_el", "kind": "desc", "value": "从相册选择", "timeout_ms": 5000},
    {"type": "wait", "ms": 2000},
    {"type": "tap_el", "kind": "desc", "value": "下一步", "timeout_ms": 5000},
    {"type": "wait", "ms": 2000},
    {"type": "tap_el", "kind": "id", "value": "title_input", "timeout_ms": 3000},
    {"type": "text", "text": "{{title}}"},
    {"type": "wait", "ms": 1000},
    {"type": "tap_el", "kind": "id", "value": "content_input", "timeout_ms": 3000},
    {"type": "text", "text": "{{content}}"},
    {"type": "wait", "ms": 1000},
    {"type": "tap_el", "kind": "text", "value": "发布", "timeout_ms": 5000},
    {"type": "wait", "ms": 5000},
    {"type": "verify_publish", "ocr_text": "发布成功", "wait_ms": 10000, "strict_ocr": false},
    {"type": "detect_risk", "ocr_keywords": ["验证码", "审核", "违规"], "on_risk": "screenshot"}
  ],
  "variables": ["title", "content"],
  "timeout_sec": 120
}
