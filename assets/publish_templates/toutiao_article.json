{
  "name": "今日头条图文发布",
  "platform": "今日头条",
  "package": "com.ss.android.article.news",
  "description": "今日头条/头条号图文发布流程，含标题/正文/标签填写，风控检测与发布验证",
  "variables": ["title", "content", "category"],
  "timeout_seconds": 150,
  "steps": [
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证", "操作频繁"], "on_risk": "abort"},
    {"type": "launch", "package": "com.ss.android.article.news"},
    {"type": "wait", "ms": 3000},
    {"type": "tap_el", "kind": "desc", "value": "发布", "contains": true},
    {"type": "wait", "ms": 1500},
    {"type": "tap_el", "kind": "desc", "value": "发图文", "contains": true},
    {"type": "wait", "ms": 2000},
    {"type": "tap_el", "kind": "id", "value": "com.ss.android.article.news:id/title_input", "contains": false, "on_fail": "continue"},
    {"type": "wait", "ms": 500},
    {"type": "text", "text": "{{title}}"},
    {"type": "wait", "ms": 500},
    {"type": "tap_el", "kind": "id", "value": "com.ss.android.article.news:id/content_input", "contains": false, "on_fail": "continue"},
    {"type": "wait", "ms": 500},
    {"type": "text", "text": "{{content}}"},
    {"type": "wait", "ms": 500},
    {"type": "tap_el", "kind": "desc", "value": "选择分类", "contains": true, "on_fail": "continue"},
    {"type": "wait", "ms": 1000},
    {"type": "tap_el", "kind": "text", "value": "{{category}}", "contains": true, "on_fail": "continue"},
    {"type": "wait", "ms": 500},
    {"type": "detect_risk", "ocr_keywords": ["验证码", "安全验证"], "on_risk": "abort"},
    {"type": "tap_el", "kind": "desc", "value": "发布", "contains": true},
    {"type": "wait", "ms": 5000},
    {"type": "verify_publish", "ocr_text": "发布成功", "wait_ms": 6000, "strict_ocr": false},
    {"type": "detect_risk", "ocr_keywords": ["审核", "违规", "限制发布"], "on_risk": "screenshot"}
  ]
}
